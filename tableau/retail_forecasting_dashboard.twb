    <worksheet name='Top 10 Feature Importance'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#0a2540' fontname='Tableau Bold' fontsize='22'>What Drives Retail Revenue Forecasts</run>
            <run>Æ&#10;</run>
            <run fontcolor='#606b76' fontname='Tableau Semibold' fontsize='16'>Recent 7-day trend accounts for 36% of predictive power. Days-until-Christmas and days-until-Cyber-Monday rank 2nd and 4th — engineered holiday-distance features outperform static calendar flags.</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='feature_importance' name='federated.1gpwns81syqied18edk4b0euwve5' />
          </datasources>
          <datasource-dependencies datasource='federated.1gpwns81syqied18edk4b0euwve5'>
            <column caption='Feature Display' datatype='string' name='[Calculation_1558323920879626]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [feature]&#13;&#10;    WHEN &quot;ma_7day&quot; THEN &quot;7-Day Moving Avg&quot;&#13;&#10;    WHEN &quot;days_until_christmas&quot; THEN &quot;Days Until Christmas&quot;&#13;&#10;    WHEN &quot;day_of_week&quot; THEN &quot;Day of Week&quot;&#13;&#10;    WHEN &quot;days_until_cyber_monday&quot; THEN &quot;Days Until Cyber Monday&quot;&#13;&#10;    WHEN &quot;rolling_std_7day&quot; THEN &quot;7-Day Volatility&quot;&#13;&#10;    WHEN &quot;dow_sin&quot; THEN &quot;Day-of-Week Cyclical&quot;&#13;&#10;    WHEN &quot;has_campaign&quot; THEN &quot;Campaign Active&quot;&#13;&#10;    WHEN &quot;days_until_black_friday&quot; THEN &quot;Days Until Black Friday&quot;&#13;&#10;    WHEN &quot;days_since_last_campaign&quot; THEN &quot;Days Since Last Campaign&quot;&#13;&#10;    WHEN &quot;rolling_std_30day&quot; THEN &quot;30-Day Volatility&quot;&#13;&#10;    WHEN &quot;is_weekend&quot; THEN &quot;Is Weekend&quot;&#13;&#10;    WHEN &quot;quarter&quot; THEN &quot;Quarter&quot;&#13;&#10;    WHEN &quot;month&quot; THEN &quot;Month&quot;&#13;&#10;    WHEN &quot;ma_30day&quot; THEN &quot;30-Day Moving Avg&quot;&#13;&#10;    WHEN &quot;days_until_ramadan&quot; THEN &quot;Days Until Ramadan&quot;&#13;&#10;    WHEN &quot;days_until_eid&quot; THEN &quot;Days Until Eid&quot;&#13;&#10;    WHEN &quot;month_sin&quot; THEN &quot;Month Cyclical&quot;&#13;&#10;    WHEN &quot;month_cos&quot; THEN &quot;Month Cyclical (Cos)&quot;&#13;&#10;    WHEN &quot;dow_cos&quot; THEN &quot;Day-of-Week Cyclical (Cos)&quot;&#13;&#10;    WHEN &quot;is_holiday_season&quot; THEN &quot;Holiday Season Flag&quot;&#13;&#10;    WHEN &quot;is_december&quot; THEN &quot;December Flag&quot;&#13;&#10;    ELSE [feature]&#13;&#10;END' />
            </column>
            <column caption='Feature' datatype='string' name='[feature]' role='dimension' type='nominal' />
            <column caption='Importance Pct' datatype='real' name='[importance_pct]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_1558323920879626]' derivation='None' name='[none:Calculation_1558323920879626:nk]' pivot='key' type='nominal' />
            <column-instance column='[feature]' derivation='None' name='[none:feature:nk]' pivot='key' type='nominal' />
            <column-instance column='[importance_pct]' derivation='Sum' name='[sum:importance_pct:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.1gpwns81syqied18edk4b0euwve5].[none:feature:nk]'>
            <groupfilter count='10' end='top' function='end' units='records' user:ui-marker='end' user:ui-top-by-field='true'>
              <groupfilter direction='DESC' expression='SUM([importance_pct])' function='order' user:ui-marker='order'>
                <groupfilter function='level-members' level='[none:feature:nk]' user:ui-enumeration='all' user:ui-marker='enumerate' />
              </groupfilter>
            </groupfilter>
          </filter>
          <shelf-sorts>
            <shelf-sort-v2 dimension-to-sort='[federated.1gpwns81syqied18edk4b0euwve5].[none:Calculation_1558323920879626:nk]' direction='DESC' is-on-innermost-dimension='true' measure-to-sort-by='[federated.1gpwns81syqied18edk4b0euwve5].[sum:importance_pct:qk]' shelf='rows' />
          </shelf-sorts>
          <slices>
            <column>[federated.1gpwns81syqied18edk4b0euwve5].[none:feature:nk]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='cell'>
            <format attr='text-format' field='[federated.1gpwns81syqied18edk4b0euwve5].[sum:importance_pct:qk]' value='*0.00&quot;%&quot;' />
          </style-rule>
