      <column caption='KPI Display' datatype='string' name='[Calculation_1558323889827840]' role='measure' type='nominal'>
        <calculation class='tableau' formula='&quot;TOTAL REVENUE: £&quot; + STR(ROUND(SUM([revenue])/1000000000, 2)) + &quot;B  |  &quot; +&#13;&#10;&quot;AVG DAILY: £&quot; + STR(ROUND(AVG([revenue])/1000000, 2)) + &quot;M  |  &quot; +&#13;&#10;&quot;BEST MODEL: XGBoost @ 2.95% MAPE  |  &quot; +&#13;&#10;&quot;BASELINE BEATEN BY: 83.4%&quot;' />
      </column>
      <column caption='Total Revenue' datatype='real' name='[Calculation_1558323900407813]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([revenue])' />
      </column>
      <column caption='Avg Daily Revenue' datatype='real' name='[Calculation_1558323900461062]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([revenue])' />
      </column>
      <column caption='Best Model MAPE' datatype='real' name='[Calculation_1558323900502023]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='0.0295' />
      </column>
      <column caption='Beats Baseline By' datatype='real' name='[Calculation_1558323900542984]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='0.834' />
      </column>
